rules_version = '2';

// TEMPORARY rules used ONLY by scripts/seed.mjs to create role docs and sample
// data. Allows any signed-in user to read/write. DO NOT leave this deployed —
// the production rules in firestore.rules are redeployed immediately after.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
