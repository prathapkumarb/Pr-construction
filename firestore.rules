rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    // isSignedIn() always short-circuits first, so request.auth.uid is never
    // accessed when unauthenticated and get() is only called for valid sessions.
    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) != true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // Any active user with a non-pending role (admin, supervisor, or any custom role like hr, site_manager)
    function isStaff() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) != true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role != 'pending';
    }

    // User profiles. Users may read their own doc and create it (as pending)
    // on first login. Admins can create docs for other users (e.g. admin-provisioned accounts)
    // and can read everyone, change roles, or delete.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin()
                    || (isSignedIn()
                        && request.auth.uid == uid
                        && request.resource.data.role == 'pending');
      allow update, delete: if isAdmin();
    }

    // Admin-created user credentials (passwords). Admin-only.
    match /userCredentials/{uid} {
      allow read, write: if isAdmin();
    }

    // Suppliers & materials: staff can read and create on the fly.
    // Only admins can edit details / delete (used by merge).
    match /suppliers/{id} {
      allow read, create: if isStaff();
      allow update, delete: if isAdmin();
    }
    match /materials/{id} {
      allow read, create: if isStaff();
      allow update, delete: if isAdmin();
    }

    // Deliveries: physical facts, no money. Staff read & create.
    // Admin can edit/reassign (used by supplier merge) and delete.
    match /deliveries/{id} {
      allow read, create: if isStaff();
      allow update, delete: if isAdmin();
    }

    // Site locations: non-financial master data. Staff can read, create, reactivate.
    // Only admins can delete.
    match /sites/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // Labour module: workers, attendance, payments.
    // Staff can create (supervisors mark attendance, record advances).
    // Only admins can edit/delete historical records.
    match /labourWorkers/{id} {
      allow read, create: if isStaff();
      allow update, delete: if isAdmin();
    }
    match /labourAttendance/{id} {
      allow read, create: if isStaff();
      allow update, delete: if isAdmin();
    }
    match /labourPayments/{id} {
      allow read, create: if isStaff();
      allow update, delete: if isAdmin();
    }
    match /labourRates/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    // App-level settings (e.g. access control config). Any signed-in user may read
    // so their role's access config loads on login. Only admins may write.
    match /settings/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // MONEY — admin always has full access. Other active roles can read if the
    // access config grants them the relevant permission.
    match /deliveryFinancials/{id} {
      allow read: if isAdmin()
        || (isStaff()
            && get(/databases/$(database)/documents/settings/accessControl)
                .data.get(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role, {})
                .get('fields', {}).get('deliveryPricing', false) == true);
      allow write: if isAdmin();
    }
    match /payments/{id} {
      allow read: if isAdmin()
        || (isStaff()
            && get(/databases/$(database)/documents/settings/accessControl)
                .data.get(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role, {})
                .get('tabs', {}).get('subPayments', false) == true);
      allow write: if isAdmin();
    }
  }
}
